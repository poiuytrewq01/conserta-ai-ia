# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# IA generativa - qualquer provedor compatível com a API da OpenAI
# Padrão: Gemini (chave grátis em https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=coloque_sua_chave_aqui
LLM_MODELO=gemini-flash-lite-latest
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=4

# Visão computacional
VISAO_MODELO=openai/clip-vit-base-patch32
VISAO_LIMIAR_CONFIANCA=0.5
VISAO_TAMANHO_MAX_MB=10
